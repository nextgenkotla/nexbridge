DirectoryIndex index.php
Options -Indexes
ErrorDocument 404 /index.php

# Keep source files, content data and repo internals private
RedirectMatch 404 ^/(app|build|content|\.git|\.github|api/data|admin/lib)(/|$)
RedirectMatch 404 ^/api/config\.php$
RedirectMatch 404 \.(py|md|csv|json)$

# Every page is rendered by index.php (old page addresses are redirected there too)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/admin/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
