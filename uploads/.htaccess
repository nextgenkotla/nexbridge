# Images uploaded in the admin panel. Nothing in this folder may run as code.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .php5 .php7 .php8 .pht
RemoveType .php .phtml .phar .php5 .php7 .php8 .pht
<FilesMatch "\.(?i:php\d?|phtml|phar|pht|cgi|pl|py|sh|html?|svg|js)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set Content-Security-Policy "default-src 'none'"
  Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
